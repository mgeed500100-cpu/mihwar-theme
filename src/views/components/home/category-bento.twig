<section component-id="{{ componentId }}" class="mihwar-section mihwar-categories" data-mihwar-reveal>
  <div class="container">
    <div class="mihwar-heading"><div><span class="mihwar-kicker">{{ trans('mihwar.quick_access') }}</span><h2>{{ component.title }}</h2></div><p>{{ component.description }}</p></div>
    <div class="mihwar-bento">
      {% for category in component.categories %}
        <a href="{{ category.url }}" class="mihwar-bento__item mihwar-bento__item--{{ loop.index }}">
          {% if category.image %}<img loading="lazy" src="{{ category.image }}" alt="{{ category.name }}">{% endif %}
          <span><strong>{{ category.name }}</strong><small>{{ trans('mihwar.explore_category') }}</small></span>
          <i class="sicon-arrow-left"></i>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
